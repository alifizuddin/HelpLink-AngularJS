# Copy this file to .env and fill in your real API keys.
# Never commit .env to version control.

# GNews API key (https://gnews.io)
GNEWS_API_KEY=your_gnews_api_key_here

# JSearch RapidAPI key (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=your_jsearch_api_key_here

# Port the proxy listens on (optional, default 3000)
# PORT=3000
